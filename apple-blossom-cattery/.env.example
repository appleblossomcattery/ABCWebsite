# Copy to .env for local development with `netlify dev`.
# In production, set these in Netlify → Site configuration → Environment variables.
# NEVER commit the real .env file.

# --- Email (Resend) ---
# Required. Your Resend API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (defaults are set in code).
# MAIL_FROM must be on a domain VERIFIED in Resend (appleblossomcatterybookings.com).
MAIL_FROM=Apple Blossom Cattery <enquiries@appleblossomcatterybookings.com>
MAIL_TO=laura@appleblossomcattery.com
MAIL_CC=bookings@appleblossomcattery.com

# --- CatBooker Pen Checker integration (future) ---
# When set, the site performs a live availability check via CatBooker.
# CATBOOKER_API_URL=https://catbooker.netlify.app/api/pen-check
# PEN_CHECK_SECRET=the-same-long-random-secret-you-set-on-catbooker
